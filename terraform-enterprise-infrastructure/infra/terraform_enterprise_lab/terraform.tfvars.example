platform_settings = {
  project_id = "prj-cedar-tfe-platform"
  region     = "us-central1"
  zone       = "us-central1-a"
  labels = {
    environment = "lab"
    owner       = "portfolio"
  }
}

network_settings = {
  vpc_name               = "cedar-tfe-platform-vpc"
  management_subnet_name = "cedar-tfe-management"
  data_subnet_name       = "cedar-tfe-data"
  management_subnet_cidr = "10.70.10.0/24"
  data_subnet_cidr       = "10.70.20.0/24"
  private_services_cidr  = "10.70.30.0/24"
}

database_settings = {
  name             = "cedar-tfe-postgres"
  database_version = "POSTGRES_15"
  tier             = "db-f1-micro"
  database_name    = "terraform_enterprise"
  user_name        = "tfe_runtime"
  password         = "REPLACE_WITH_PRIVATE_DATABASE_PASSWORD"
}

artifacts_settings = {
  bucket_name    = "cedar-tfe-artifacts-prj-cedar-tfe-platform"
  key_ring_name  = "cedar-tfe-key-ring"
  key_name       = "cedar-tfe-artifacts"
  retention_days = 7
}
