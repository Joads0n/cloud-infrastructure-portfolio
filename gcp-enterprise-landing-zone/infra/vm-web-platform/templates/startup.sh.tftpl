#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

# O NAT pode levar algum tempo para ficar disponível. O APT verifica os metadados assinados dos repositórios.
apt-get -o Acquire::Retries=5 -o DPkg::Lock::Timeout=180 update
apt-get -o Acquire::Retries=5 -o DPkg::Lock::Timeout=180 install -y --no-install-recommends nginx curl

install -d -m 0755 /var/www/crl /var/lib/crl
if [ ! -s /var/lib/crl/backend-token ]; then
  cut -c 1-12 /proc/sys/kernel/random/uuid > /var/lib/crl/backend-token
fi
backend_token=$(tr -d '\n' < /var/lib/crl/backend-token)
backend_color=$(printf '%s' "$backend_token" | cut -c 1-6)
printf '%s' '${page}' | base64 --decode > /var/www/crl/index.html
sed -i "s/__BACKEND_TOKEN__/$backend_token/g" /var/www/crl/index.html
sed -i "s/__BACKEND_COLOR__/$backend_color/g" /var/www/crl/index.html

# Sobrescreva somente o site padrão do Nginx na VM descartável, não na máquina do usuário.
cat > /etc/nginx/sites-available/default <<NGINX
server {
    listen 80 default_server;
    server_name ${hostname};
    server_tokens off;
    root /var/www/crl;
    access_log off;
    add_header X-Lab-Backend "$backend_token" always;
    add_header Cache-Control "no-store" always;
    location = /healthz { default_type text/plain; return 200 "ok\n"; }
    location = / { try_files /index.html =404; }
    location / { return 404; }
}
NGINX
nginx -t
systemctl enable nginx
systemctl restart nginx

# Instalador oficial do Ops Agent. Falhas no download HTTPS interrompem a execução; nunca encaminhe o download diretamente ao shell.
# Executado a cada inicialização; pula a instalação quando o pacote já está presente.
if ! dpkg-query -W -f='$${Status}' google-cloud-ops-agent 2>/dev/null | grep -q 'install ok installed'; then
  ops_installer=$(mktemp /tmp/crl-ops-agent.XXXXXX)
  trap 'rm -f "$ops_installer"' EXIT
  curl --fail --silent --show-error --location --retry 5 \
    https://dl.google.com/cloudagents/add-google-cloud-ops-agent-repo.sh \
    --output "$ops_installer"
  bash "$ops_installer" --also-install
fi
systemctl enable --now google-cloud-ops-agent
systemctl is-active --quiet google-cloud-ops-agent
