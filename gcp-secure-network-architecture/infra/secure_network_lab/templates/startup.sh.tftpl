#!/usr/bin/env bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y nginx curl ca-certificates

curl -fsSLO https://dl.google.com/cloudagents/add-google-cloud-ops-agent-repo.sh
bash add-google-cloud-ops-agent-repo.sh --also-install --version="2.*.*"
rm -f add-google-cloud-ops-agent-repo.sh

cat >/var/www/html/index.html <<'HTML'
<!doctype html>
<html lang="pt-BR">
  <meta charset="utf-8">
  <title>Vértice Comércio Digital</title>
  <body>
    <h1>Vértice Comércio Digital</h1>
    <p>Função da VM: ${role}</p>
    <p>Serviço interno: ${service_hostname}</p>
  </body>
</html>
HTML

if [[ "${role}" == "orders-service" ]]; then
  cat >/var/www/html/orders.json <<'JSON'
{"service":"orders-and-inventory","company":"vertice-comercio-digital","fictional":true}
JSON
fi

systemctl enable nginx
systemctl restart nginx
