# Somente valores fictícios. Copie para um arquivo privado e substitua os IDs do ambiente avaliador.
# Labels de projeto não devem repetir as reservadas environment e managed_by.
# A zona precisa pertencer à região definida em deployment_settings.

# Projeto, faturamento, hierarquia e labels do projeto
project_settings = {
  # O projeto será criado por este root com o usuário autenticado do avaliador.
  create_project     = true
  project_id         = "fictional-m2vm-lab"
  project_name       = "Maple Harbor VM Migration Lab"
  billing_account_id = "000000-000000-000000"
  organization_id    = null
  folder_id          = null
  labels = {
    owner          = "platform"
    cost_center    = "cloud-lab"
    scope          = "vm-migration"
    migration_type = "aws-to-gcp"
  }
}

# Ambiente, prefixo, região e zona dos recursos
deployment_settings = {
  environment     = "lab"
  resource_prefix = "mhr-m2vm-lab"
  region          = "us-central1"
  zone            = "us-central1-a"
}

# Rede; nomes podem ser omitidos para usar o prefixo do ambiente
network_settings = {
  subnet_cidr = "10.82.10.0/24"
}

m2vm_settings = {
  source_name               = "mhr-m2vm-aws-source"
  aws_organization          = "Maple Harbor Retail AWS organization"
  aws_account_alias         = "maple-harbor-migration"
  aws_region                = "us-east-1"
  source_vm_count           = 2
  source_has_load_balancer  = true
  source_has_nat_egress     = true
  source_vm_tag_key         = "migrate-to-gcp"
  source_vm_tag_value       = "true"
  source_security_group_ids = ["sg-fictional-m2vm-source"]

  # As duas VMs devem ser criadas pelo M2VM, não por este root Terraform.
  # Preencha estes valores depois que o M2VM criar as VMs de destino no GCP.
  target_instance_self_links = []
}

cutover_settings = {
  active_backend      = "aws"
  fictional_source_ip = "198.51.100.20"
  ttl                 = 30
}
