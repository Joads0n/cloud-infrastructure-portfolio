platform_settings = {
  bootstrap_project_id = "prj-maple-bootstrap"
  region               = "us-central1"
  zone                 = "us-central1-a"
  labels = {
    environment = "lab"
    owner       = "cloud-platform"
  }
}

project_settings = {
  project_id         = "prj-maple-m2vm-lab"
  project_name       = "Laboratório de migração de VMs Maple Harbor"
  billing_account_id = "REPLACE_WITH_BILLING_ACCOUNT_ID"
  folder_id          = "REPLACE_WITH_FOLDER_ID_OR_EMPTY"
  create_project     = true
}

network_settings = {
  subnet_cidr = "10.82.10.0/24"
}

m2vm_settings = {
  source_name               = "maple-aws-source"
  aws_organization          = "Maple Harbor Retail AWS organization"
  aws_account_alias         = "maple-harbor-migration"
  aws_region                = "us-east-1"
  source_vm_tag_key         = "migrate-to-gcp"
  source_vm_tag_value       = "true"
  source_security_group_ids = ["sg-fictional-m2vm-source"]

  # As duas VMs devem ser criadas pelo M2VM, não por este root Terraform.
  # Preencha estes valores depois que o M2VM criar as VMs de destino no GCP.
  target_instance_self_links = []
}

cutover_settings = {
  active_backend      = "aws"
  fictional_source_ip = "198.51.100.20"
  ttl                 = 30
}
